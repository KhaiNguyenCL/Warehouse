{
  "name": "@wms/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:latest": "tsx $(node -p \"require.resolve('knex/bin/cli.js')\") --knexfile knexfile.ts migrate:latest",
    "migrate:rollback": "tsx $(node -p \"require.resolve('knex/bin/cli.js')\") --knexfile knexfile.ts migrate:rollback",
    "migrate:make": "tsx $(node -p \"require.resolve('knex/bin/cli.js')\") --knexfile knexfile.ts migrate:make"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^6.12.0",
    "@wms/types": "workspace:*",
    "adm-zip": "^0.5.16",
    "bcrypt": "^5.1.1",
    "carbone": "^3.8.2",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "fastify-plugin": "^4.5.1",
    "knex": "^3.1.0",
    "node-cron": "^4.6.0",
    "pg": "^8.12.0",
    "puppeteer": "^25.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2",
    "vitest": "^2.0.5"
  }
}
