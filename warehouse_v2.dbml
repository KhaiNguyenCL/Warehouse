// ================================================
// DNS Technology Invest Co., Ltd
// Warehouse Management System — Database Schema v3.0
// ================================================
//
// Changelog v3.0 (so với v2.1):
//   + Bảng mới: brands (tách khỏi products.brand text tự do)
//   + Bảng mới: purchase_orders + purchase_order_lines
//   + Bảng mới: document_sequences (sinh mã chứng từ tự động)
//   + categories.short_code
//   + products.brand_id → FK tới brands (thay products.brand varchar)
//   + receipt_lines: thêm po_line_id, qty_remaining, warranty_months
//   + receipts.po_id (liên kết tuỳ chọn tới purchase_orders)
//   + delivery_orders: thêm ref_document_type, ref_document_id
//   + custom_fields.object_type: thêm 'variant'
//   + custom_fields.applies_to_po_line
//   + stock_movements.serial_id: ON DELETE SET NULL
//   - Bỏ bảng stock_batches: receipt_lines ĐÃ LÀ lô nhập (qty_remaining)
//   - serial_numbers.batch_id: bỏ theo stock_batches
//   * Mã chứng từ (code) tất cả document: auto-generated PREFIX-YYYY-NNNN,
//     không còn nhập tay
// ================================================

// ================================================
// USERS & RBAC
// ================================================

Table roles {
  id          uuid    [primary key]
  name        varchar [note: 'VD: Admin, Manager, Warehouse, Sale, Accounting']
  description text
  is_system   boolean [default: false, note: 'true = role mặc định, không xoá được']
  created_at  timestamp
  updated_at  timestamp
}

Table permissions {
  id          uuid    [primary key]
  key         varchar [unique, note: 'VD: receipt.approve, delivery.create, quotation.confirm']
  description varchar
  group       varchar [note: 'quotation/receipt/delivery/transfer/stocktake/report/settings/purchase_order']
}

Table role_permissions {
  role_id       uuid [ref: > roles.id]
  permission_id uuid [ref: > permissions.id]

  indexes {
    (role_id, permission_id) [unique]
  }
}

Table users {
  id            uuid    [primary key]
  full_name     varchar
  email         varchar [unique]
  phone         varchar
  password_hash varchar [note: 'bcrypt hash']
  role_id       uuid    [ref: > roles.id, note: '1 user chỉ có 1 role']
  is_active     boolean [default: true]
  created_at    timestamp
  updated_at    timestamp
}

// ================================================
// COMPANIES & CONTACTS
// ================================================

Table companies {
  id                uuid    [primary key]
  code              varchar [unique, note: 'Mã nội bộ']
  name              varchar
  tax_code          varchar [note: 'Mã số thuế']
  country           char(2) [default: 'VN', note: 'ISO 3166-1 alpha-2']
  address           varchar
  phone             varchar
  email             varchar
  bank_account      varchar
  bank_name         varchar
  bitrix_company_id varchar [note: 'ID Company bên Bitrix']
  is_active         boolean [default: true]
  note              text
  created_at        timestamp
  updated_at        timestamp
}

Table company_types {
  id         uuid    [primary key]
  company_id uuid    [ref: > companies.id]
  type       varchar [note: 'customer / supplier']

  indexes {
    (company_id, type) [unique]
  }
}

Table contacts {
  id                uuid    [primary key]
  company_id        uuid    [ref: > companies.id]
  full_name         varchar
  position          varchar [note: 'Chức vụ']
  phone             varchar
  email             varchar
  is_primary        boolean [default: false]
  bitrix_contact_id varchar [note: 'ID Contact bên Bitrix']
  note              text
}

// ================================================
// WAREHOUSES
// ================================================

Table warehouses {
  id          uuid    [primary key]
  code        varchar [unique, note: 'VD: WH-HCM, WH-HN, WH-DEMO, WH-BH']
  name        varchar
  type        varchar [note: 'physical / virtual']
  address     varchar [note: 'Chỉ áp dụng kho vật lý']
  description varchar [note: 'Mô tả mục đích kho ảo']
  manager_id  uuid    [ref: > users.id]
  is_active   boolean [default: true]
  created_at  timestamp
  updated_at  timestamp
}

// ================================================
// PRODUCT CATALOG
// ================================================

Table categories {
  id         uuid    [primary key]
  name       varchar [note: 'Router, Switch, Camera, Dịch vụ,...']
  short_code varchar [unique, note: 'Viết tắt dùng gợi ý product.code, VD: SW (Switch)']
  parent_id  uuid    [ref: > categories.id]
  is_active  boolean [default: true]
}

Table brands {
  id         uuid    [primary key]
  name       varchar [note: 'VD: Cisco, MikroTik, Hikvision']
  short_code varchar [unique, note: 'Viết tắt dùng gợi ý product.code, VD: CSC (Cisco)']
  is_active  boolean [default: true]
}

Table products {
  id           uuid    [primary key]
  code         varchar [unique, note: 'Gợi ý = category.short_code + brand.short_code + model_number']
  name         varchar
  name_en      varchar [note: 'Tên tiếng Anh cho báo giá']
  brand_id     uuid    [ref: > brands.id]
  model_number varchar [note: 'Phân biệt dòng SP cùng Category+Brand, VD: SG110, SG350']
  category_id  uuid    [ref: > categories.id]
  product_type varchar [note: 'storable / consumable / service / bundle']
  description  text
  image_url    varchar
  is_active    boolean [default: true]
  created_at   timestamp
  updated_at   timestamp
}

Table variants {
  id              uuid          [primary key]
  product_id      uuid          [ref: > products.id]
  sku             varchar       [unique, note: 'Gợi ý = product.code + field đặc thù (VD: -16GB)']
  name            varchar
  unit            varchar       [note: 'Cái, bộ, hộp, license, tháng, mét']
  cost_price      decimal(15,2) [note: 'Giá vốn tham chiếu mặc định — PO line copy lúc tạo rồi lưu độc lập']
  sale_price      decimal(15,2)
  currency        char(3)       [default: 'VND']
  weight_kg       decimal(8,3)
  warranty_months int           [note: 'Bảo hành gợi ý (tháng) — PO line copy rồi lưu độc lập']
  reorder_point   int           [note: 'Tồn tối thiểu — cảnh báo khi dưới ngưỡng']
  is_active       boolean       [default: true]
  created_at      timestamp
  updated_at      timestamp

  note: 'product_type kế thừa từ products.product_type'
}

Table bundle_items {
  id                uuid [primary key]
  bundle_variant_id uuid [ref: > variants.id, note: 'Bundle SKU (product_type=bundle)']
  item_variant_id   uuid [ref: > variants.id, note: 'Sản phẩm con']
  quantity          int  [note: 'Số lượng trong bundle, > 0']

  indexes {
    (bundle_variant_id, item_variant_id) [unique]
  }
}

Table variant_suppliers {
  id             uuid          [primary key]
  variant_id     uuid          [ref: > variants.id]
  company_id     uuid          [ref: > companies.id, note: 'Nhà cung cấp']
  supplier_sku   varchar       [note: 'Mã SKU bên NCC']
  supplier_price decimal(15,2)
  lead_time_days int
  is_preferred   boolean       [default: false, note: 'Tối đa 1 preferred per variant']
}

// ================================================
// PURCHASE ORDERS (ĐƠN ĐẶT HÀNG NCC)
// ================================================
// Cam kết mua hàng — KHÔNG động inventory trực tiếp. Receipt (import_type='purchase')
// tham chiếu ngược po_id/po_line_id để tính tiến độ nhận hàng.
// State machine: draft → confirmed → cancelled

Table purchase_orders {
  id             uuid      [primary key]
  code           varchar   [note: 'Auto-generated: PO-YYYY-NNNN']
  company_id     uuid      [ref: > companies.id, note: 'Nhà cung cấp']
  contact_id     uuid      [ref: > contacts.id]
  bitrix_deal_id varchar
  status         varchar   [note: 'draft / confirmed / cancelled']
  note           text
  created_by     uuid      [ref: > users.id]
  created_at     timestamp
  updated_at     timestamp
}

Table purchase_order_lines {
  id                uuid          [primary key]
  purchase_order_id uuid          [ref: > purchase_orders.id]
  variant_id        uuid          [ref: > variants.id]
  quantity          int           [note: '> 0']
  unit_price        decimal(15,2) [note: 'Copy từ variants.cost_price lúc tạo, lưu độc lập']
  warranty_months   int           [note: 'Copy từ variants.warranty_months lúc tạo, lưu độc lập']
  line_order        int           [default: 0]
  note              text

  note: 'Tiến độ: received_qty + pending_qty + remaining_qty tính động từ receipt_lines (không lưu cột riêng)'
}

// ================================================
// QUOTATIONS (BÁO GIÁ)
// ================================================
// State machine: draft → confirmed → expired (auto) / cancelled (manual)

Table quotations {
  id                uuid          [primary key]
  code              varchar       [note: 'Auto-generated: BG-YYYY-NNNN']
  company_id        uuid          [ref: > companies.id]
  contact_id        uuid          [ref: > contacts.id]
  project_name      varchar
  delivery_location varchar
  warehouse_id      uuid          [ref: > warehouses.id, note: '1 kho cho cả quotation — tạo reserved_items khi Confirm']
  valid_days        int
  expired_at        date
  bitrix_deal_id    varchar       [note: 'ID deal Bitrix, tùy chọn']
  bitrix_deal_url   varchar
  bitrix_synced_at  timestamp
  status            varchar       [note: 'draft / confirmed / expired / cancelled']
  subtotal          decimal(15,2)
  vat_total         decimal(15,2)
  discount          decimal(15,2)
  grand_total       decimal(15,2)
  amount_in_words   varchar
  terms             text
  created_by        uuid          [ref: > users.id]
  created_at        timestamp
  updated_at        timestamp

  note: 'Tiến độ xuất hàng: exported_qty + pending_qty + remaining_qty tính động từ delivery_order_lines'
}

Table quotation_sections {
  id            uuid          [primary key]
  quotation_id  uuid          [ref: > quotations.id]
  name          varchar       [note: 'Thiết bị, Nhân công, Dịch vụ,...']
  section_order int
  subtotal      decimal(15,2)
}

Table quotation_line_items {
  id           uuid          [primary key]
  quotation_id uuid          [ref: > quotations.id, note: 'Trỏ thẳng để join nhanh, không qua section']
  section_id   uuid          [ref: > quotation_sections.id]
  variant_id   uuid          [ref: > variants.id, note: 'Null nếu mô tả tự do']
  bundle_id    uuid          [ref: > variants.id, note: 'Null nếu không phải bundle']
  description  varchar
  unit         varchar
  quantity     decimal(10,2)
  unit_price   decimal(15,2)
  warranty     varchar
  line_total   decimal(15,2)
  vat_percent  decimal(5,2)
  vat_amount   decimal(15,2)
  is_reserved  boolean       [default: true, note: 'Có giữ chỗ tồn kho khi Confirm không']
  line_order   int
  note         text
}

// ================================================
// RECEIPTS (PHIẾU NHẬP KHO)
// ================================================
// State machine: draft → pending_approval → approved → completed / cancelled
// po_id tuỳ chọn — không phải mọi receipt purchase đều từ PO chính thức

Table receipts {
  id                uuid      [primary key]
  code              varchar   [note: 'Auto-generated: NK-YYYY-NNNN']
  import_type       varchar   [note: 'purchase / return_in / adjustment']
  company_id        uuid      [ref: > companies.id, note: 'NCC hoặc KH tuỳ import_type']
  contact_id        uuid      [ref: > contacts.id]
  warehouse_id      uuid      [ref: > warehouses.id, note: 'Kho đích']
  po_id             uuid      [ref: > purchase_orders.id, note: 'Liên kết tuỳ chọn tới PO (phải Confirmed)']
  ref_document_type varchar   [note: 'quotation / stocktake_result (tùy chọn)']
  ref_document_id   uuid
  status            varchar   [note: 'draft / pending_approval / approved / completed / cancelled']
  approved_by       uuid      [ref: > users.id]
  approved_at       timestamp
  completed_at      timestamp
  note              text
  created_by        uuid      [ref: > users.id]
  created_at        timestamp
  updated_at        timestamp
}

Table receipt_lines {
  id              uuid          [primary key]
  receipt_id      uuid          [ref: > receipts.id]
  variant_id      uuid          [ref: > variants.id]
  po_line_id      uuid          [ref: > purchase_order_lines.id, note: 'Dòng PO đang nhận (tuỳ chọn) — tính received_qty/remaining_qty']
  quantity        int           [note: '> 0']
  qty_remaining   int           [note: 'Set = quantity khi Receipt Complete; FIFO consumer của Delivery trừ dần']
  cost_price      decimal(15,2) [note: 'Giá nhập từ hoá đơn NCC — lưu độc lập theo lô']
  warranty_months int           [note: 'Bảo hành thực tế lô này — tính warranty_end = completed_at + warranty_months']
  line_order      int
  note            text

  note: 'Mỗi receipt_line = 1 lô nhập (không có bảng stock_batches riêng). FIFO order: receipts.completed_at ASC, receipt_lines.line_order ASC'
}

// ================================================
// DELIVERY ORDERS (PHIẾU XUẤT KHO)
// ================================================
// State machine: draft → pending_approval → approved → completed / cancelled

Table delivery_orders {
  id                uuid      [primary key]
  code              varchar   [note: 'Auto-generated: XK-YYYY-NNNN']
  export_type       varchar   [note: 'sale / internal / demo_out / warranty_out / return_out / dispose / adjustment']
  company_id        uuid      [ref: > companies.id, note: 'KH hoặc NCC tuỳ export_type']
  contact_id        uuid      [ref: > contacts.id]
  warehouse_id      uuid      [ref: > warehouses.id, note: 'Kho nguồn']
  quotation_id      uuid      [ref: > quotations.id, note: 'Bắt buộc nếu export_type=sale']
  ref_document_type varchar   [note: 'stocktake_result (dùng cho export_type=adjustment)']
  ref_document_id   uuid
  status            varchar   [note: 'draft / pending_approval / approved / completed / cancelled']
  approved_by       uuid      [ref: > users.id]
  approved_at       timestamp
  completed_at      timestamp
  reason            text      [note: 'Lý do xuất nội bộ hoặc huỷ hàng']
  note              text
  created_by        uuid      [ref: > users.id]
  created_at        timestamp
  updated_at        timestamp
}

Table delivery_order_lines {
  id                     uuid [primary key]
  delivery_order_id      uuid [ref: > delivery_orders.id]
  variant_id             uuid [ref: > variants.id]
  quantity               int  [note: '> 0']
  bundle_id              uuid [ref: > variants.id, note: 'Null nếu không từ bundle']
  quotation_line_item_id uuid [ref: > quotation_line_items.id, note: 'Set khi sale — tính exported_qty/remaining_qty và giải phóng reserved']
  line_order             int
  note                   text
}

// ================================================
// TRANSFER ORDERS (PHIẾU CHUYỂN KHO)
// ================================================
// State machine: draft → pending_approval → approved → completed / cancelled

Table transfer_orders {
  id                uuid      [primary key]
  code              varchar   [note: 'Auto-generated: CK-YYYY-NNNN']
  transfer_type     varchar   [note: 'transfer / warranty_in / demo_in / qc_pass / sn_ready']
  from_warehouse_id uuid      [ref: > warehouses.id]
  to_warehouse_id   uuid      [ref: > warehouses.id]
  status            varchar   [note: 'draft / pending_approval / approved / completed / cancelled']
  approved_by       uuid      [ref: > users.id]
  approved_at       timestamp
  completed_at      timestamp
  note              text
  created_by        uuid      [ref: > users.id]
  created_at        timestamp
  updated_at        timestamp
}

Table transfer_order_lines {
  id                uuid [primary key]
  transfer_order_id uuid [ref: > transfer_orders.id]
  variant_id        uuid [ref: > variants.id]
  quantity          int  [note: '> 0']
  line_order        int
  note              text
}

// ================================================
// INVENTORY
// ================================================

Table serial_numbers {
  id               uuid    [primary key]
  serial_no        varchar [unique]
  variant_id       uuid    [ref: > variants.id]
  warehouse_id     uuid    [ref: > warehouses.id, note: 'null khi sold / disposed']
  status           varchar [note: 'active / sold / disposed']
  receipt_line_id  uuid    [ref: > receipt_lines.id,        note: 'Lô nhập từ phiếu nào']
  delivery_line_id uuid    [ref: > delivery_order_lines.id, note: 'Xuất theo phiếu nào — set khi DO Completed']
  mac_address      varchar [note: 'Thiết bị mạng có MAC']
  warranty_end     date    [note: 'completed_at + receipt_line.warranty_months (set khi Receipt Completed)']
  note             text
  created_at       timestamp
  updated_at       timestamp
}

Table inventory {
  id           uuid          [primary key]
  variant_id   uuid          [ref: > variants.id]
  warehouse_id uuid          [ref: > warehouses.id]
  qty_on_hand  int           [default: 0, note: '≥ 0']
  qty_reserved int           [default: 0, note: '≥ 0']
  avg_cost     decimal(15,2) [note: '(old_qty * old_avg + new_qty * new_cost) / (old_qty + new_qty)']
  last_updated timestamp

  indexes {
    (variant_id, warehouse_id) [unique]
  }

  note: 'qty_available = qty_on_hand − qty_reserved'
}

Table reserved_items {
  id                     uuid      [primary key]
  variant_id             uuid      [ref: > variants.id]
  warehouse_id           uuid      [ref: > warehouses.id, note: 'Kho nào bị giữ chỗ']
  quantity               int       [note: '> 0']
  source_type            varchar   [note: 'quotation / delivery_order']
  source_id              uuid      [note: 'FK động → quotations.id hoặc delivery_orders.id']
  quotation_line_item_id uuid      [ref: > quotation_line_items.id, note: 'Null nếu source là delivery_order']
  created_at             timestamp
}

Table stock_movements {
  id                uuid          [primary key]
  variant_id        uuid          [ref: > variants.id]
  warehouse_id      uuid          [ref: > warehouses.id]
  serial_id         uuid          [ref: > serial_numbers.id, note: 'Null nếu consumable; ON DELETE SET NULL (return_out hard-delete serial)']
  movement_type     varchar       [note: 'in / out']
  quantity          int           [note: '> 0']
  unit_cost         decimal(15,2) [note: 'Giá vốn tại thời điểm xuất — dùng cho COGS']
  ref_document_type varchar       [note: 'receipt / delivery_order / transfer_order']
  ref_document_id   uuid
  created_by        uuid          [ref: > users.id]
  created_at        timestamp
}

// ================================================
// DOCUMENT SEQUENCES (SINH MÃ CHỨNG TỪ)
// ================================================
// Atomic counter per (doc_type, year) — INSERT ... ON CONFLICT DO UPDATE RETURNING
// đảm bảo 2 request đồng thời luôn nhận 2 seq khác nhau.
// Prefix: NK (receipt), XK (delivery_order), CK (transfer_order), BG (quotation), PO (purchase_order)

Table document_sequences {
  doc_type varchar [note: 'receipt / delivery_order / transfer_order / quotation / purchase_order']
  year     int
  last_seq int     [default: 0]

  indexes {
    (doc_type, year) [pk]
  }

  note: 'Format mã chứng từ: PREFIX-YYYY-NNNN (NNNN = last_seq padStart 4)'
}

// ================================================
// STOCKTAKE (KIỂM KÊ)
// ================================================
// Kho KHÔNG bị khoá khi kiểm kê — dùng snapshot qty_system.
// State machine: in_progress → completed / cancelled

Table stocktakes {
  id           uuid      [primary key]
  code         varchar
  warehouse_id uuid      [ref: > warehouses.id]
  scope_type   varchar   [note: 'all / by_sku / by_category']
  scope_ids    jsonb     [note: 'Danh sách SKU/category nếu scope không phải all']
  status       varchar   [note: 'in_progress / completed / cancelled']
  started_at   timestamp
  completed_at timestamp
  created_by   uuid      [ref: > users.id]
  note         text
}

Table stocktake_lines {
  id           uuid [primary key]
  stocktake_id uuid [ref: > stocktakes.id]
  variant_id   uuid [ref: > variants.id]
  qty_system   int  [note: 'Snapshot qty_on_hand lúc bắt đầu kiểm kê']
  qty_actual   int  [note: 'Số lượng thực tế đếm được']
  difference   int  [note: 'GENERATED: qty_actual − qty_system (NULL nếu qty_actual chưa nhập)']
}

Table stocktake_serials {
  id           uuid    [primary key]
  stocktake_id uuid    [ref: > stocktakes.id]
  serial_id    uuid    [ref: > serial_numbers.id]
  status       varchar [note: 'found / missing / unexpected']

  indexes {
    (stocktake_id, serial_id) [unique]
  }

  note: 'found = có trong hệ thống và thực tế. missing = hệ thống có nhưng không thấy. unexpected = thấy nhưng hệ thống không có'
}

Table stocktake_results {
  id           uuid      [primary key]
  stocktake_id uuid      [ref: > stocktakes.id, note: 'Quan hệ 1-1']
  total_sku    int
  matched      int       [note: 'Số SKU khớp']
  shortage     int       [note: 'Số SKU thiếu']
  surplus      int       [note: 'Số SKU thừa']
  created_at   timestamp
  note         text
}

// ================================================
// TEMPLATE MODULE
// ================================================

Table document_templates {
  id          uuid      [primary key]
  name        varchar
  object_type varchar   [note: 'quotation / receipt / delivery_order']
  file_path   varchar
  is_default  boolean   [default: false]
  is_active   boolean   [default: true]
  created_by  uuid      [ref: > users.id]
  created_at  timestamp
}

Table template_field_mappings {
  id                uuid    [primary key]
  template_id       uuid    [ref: > document_templates.id]
  template_variable varchar [note: 'VD: {d.customer_name}']
  source_type       varchar [note: 'database / bitrix']
  database_field    varchar [note: 'VD: company.name']
  bitrix_field      varchar [note: 'VD: TITLE, OPPORTUNITY, UF_CRM_XXX']
  is_required       boolean [default: false]
}

// ================================================
// BITRIX INTEGRATION
// ================================================

Table bitrix_field_mappings {
  id              uuid    [primary key]
  quotation_field varchar [unique, note: 'VD: project_name, terms, delivery_location']
  bitrix_object   varchar [note: 'deal / company / contact']
  bitrix_field    varchar [note: 'VD: TITLE, OPPORTUNITY, UF_CRM_XXX']

  note: 'Mapping nhập dữ liệu Bitrix → Quotation form. Khác template_field_mappings (xuất Carbone)'
}

// ================================================
// CUSTOM FIELDS & EAV
// ================================================

Table custom_fields {
  id                 uuid    [primary key]
  field_name         varchar [note: 'unique theo object_type']
  field_label        varchar
  field_type         varchar [note: 'text / number / date / select / boolean']
  object_type        varchar [note: 'quotation / receipt / delivery_order / product / variant / company']
  options            jsonb   [note: 'Danh sách lựa chọn khi field_type=select']
  is_system          boolean [default: false]
  is_active          boolean [default: true]
  sort_order         int
  applies_to_po_line boolean [default: false, note: 'Chỉ có ý nghĩa khi object_type=variant — cho phép nhập riêng theo từng PO line']

  indexes {
    (object_type, field_name) [unique]
  }
}

Table field_values {
  id          uuid      [primary key]
  object_type varchar   [note: 'quotation / receipt / delivery_order / product / variant / company / purchase_order_line']
  object_id   uuid      [note: 'FK động — id của object tương ứng']
  field_id    uuid      [ref: > custom_fields.id]
  value       text
  created_at  timestamp

  indexes {
    (object_type, object_id)
  }
}

// ================================================
// IMPORT/EXPORT TYPE SETTINGS
// ================================================

Table import_types {
  id                    uuid    [primary key]
  key                   varchar [unique, note: 'purchase / return_in / adjustment / custom...']
  label                 varchar [note: 'Tên hiển thị']
  parent_key            varchar [note: 'System type cha nếu là custom type']
  is_system             boolean [default: false]
  requires_company      varchar [note: 'supplier / customer / none']
  requires_ref_document varchar [note: 'quotation / stocktake_result / none']
  is_active             boolean [default: true]
}

Table export_types {
  id                 uuid    [primary key]
  key                varchar [unique, note: 'sale / internal / demo_out / warranty_out / return_out / dispose / adjustment']
  label              varchar
  parent_key         varchar [note: 'System type cha nếu là custom type']
  is_system          boolean [default: false]
  requires_company   varchar [note: 'supplier / customer / none']
  requires_quotation boolean [default: false]
  is_active          boolean [default: true]
}
